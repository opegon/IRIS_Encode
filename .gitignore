# Configuration personnelle (clés API, préférences utilisateur)
config.toml
profiles.toml

# Cache Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
*.egg-info/

# Environnement virtuel
venv/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
iris_encode.log

# Fichiers encodés (ne pas tracker)
*_[hevc].mp4
*_[hevc].mkv
*_[H264].mp4
*_[H264].mkv
*_[av1].mp4
*_[av1].mkv
*_[mux].mkv

# Matériel de test local (films, sous-titres) — jamais versionné
resources_files/

# Cache des dernières versions d'outils : régénéré, propre à la machine
data/ffmpeg_releases_cache.toml

# Binaires externes installés par le preflight (ffmpeg, mkvmerge, mpv, dovi_tool)
bin/

# Lanceur Bureau compilé sur place par launcher\build.bat — jamais versionné :
# un binaire dans un dépôt est invérifiable, chacun compile le sien depuis
# launcher/IrisEncodeLauncher.cs. L'icône binaire suit la même règle : elle
# est décodée par build.bat depuis launcher/iris.ico.b64 (texte, versionné).
IRIS_Encode.exe
launcher/iris.ico

# Fichiers temporaires
*.tmp
*.temp
.DS_Store
Thumbs.db

# Configuration locale de l'outillage
.claude/

# Revue d'interface : la sortie des captures, pas le generateur.
# Le generateur (tests/shots_tui.py) est versionne depuis la v0.8.3.5 : c'est
# lui qui a trouve le detournement de la touche T, qu'aucun test ni relecture
# ne voyait. Un garde-fou qui n'existe que sur une machine disparait au
# premier clone.
_shots/

# Scripts de diagnostic ponctuels, ecrits pour une investigation puis gardes
# sous la main. Ils ne decrivent pas le produit.
_*.py

# Instructions de projet pour Claude Code : aide-memoire local, pas un
# document du produit. Retire du depot et de son historique le 2026-08-29.
CLAUDE.md
