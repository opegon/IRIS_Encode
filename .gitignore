# Configuration personnelle (clés API, préférences utilisateur)
config.toml
profiles.toml

# Cache Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
*.egg-info/

# Environnement virtuel
venv/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
iris_encode.log

# Fichiers encodés (ne pas tracker)
*_[hevc].mp4
*_[hevc].mkv
*_[H264].mp4
*_[H264].mkv
*_[av1].mp4
*_[av1].mkv
*_[mux].mkv

# Matériel de test local (films, sous-titres) — jamais versionné
resources_files/

# Cache des dernières versions d'outils : régénéré, propre à la machine
data/ffmpeg_releases_cache.toml

# Binaires externes installés par le preflight (ffmpeg, mkvmerge, mpv, dovi_tool)
bin/

# Fichiers temporaires
*.tmp
*.temp
.DS_Store
Thumbs.db

# Configuration locale de l'outillage
.claude/

# Revue d'interface : la sortie des captures, pas le generateur.
# Le generateur (tests/shots_tui.py) est versionne depuis la v0.8.3.5 : c'est
# lui qui a trouve le detournement de la touche T, qu'aucun test ni relecture
# ne voyait. Un garde-fou qui n'existe que sur une machine disparait au
# premier clone.
_shots/
