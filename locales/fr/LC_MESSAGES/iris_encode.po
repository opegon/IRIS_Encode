msgstr "L'encodage en cours."

#: tui/screens/aide.py:307
msgid "Muxing"
msgstr "Mux"

#: tui/screens/aide.py:308
msgid "The mux in progress, and what can be done with it next."
msgstr "Le mux en cours, et ce qu'on peut en faire ensuite."

#: tui/screens/aide.py:309
