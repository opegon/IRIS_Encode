msgid "Join"
msgstr "Jonction"

#: tui/screens/aide.py:310
msgid "Put the parts of one movie back together into a single file."
msgstr "Recoudre les parties d'un même film en un seul fichier."

#: tui/screens/aide.py:311
msgid "Profiles"
msgstr "Profils"

#: tui/screens/aide.py:312
msgid "Create and set up the encoding profiles."
msgstr "Créer et régler les profils d'encodage."

