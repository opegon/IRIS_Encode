#. config.toml > [ffmpeg] > fetch_url is a settings key, keep it as is.
#: core/preflight.py:439
msgid "Fill in config.toml > [ffmpeg] > fetch_url"
msgstr "Renseignez config.toml > [ffmpeg] > fetch_url"

#: core/preflight.py:443
msgid "Download and install ffmpeg into ./bin/?"
msgstr "Télécharger et installer ffmpeg dans ./bin/ ?"

#: core/preflight.py:452
msgid "Install ffmpeg manually into ./bin/ or add it to the PATH."
msgstr "Installez ffmpeg manuellement dans ./bin/ ou ajoutez-le au PATH."

#: core/preflight.py:459
msgid "Download and install dovi_tool (Dolby Vision) into ./bin/?"
msgstr "Télécharger et installer dovi_tool (Dolby Vision) dans ./bin/ ?"

#: core/preflight.py:462
msgid "dovi_tool installation failed — Dolby Vision features unavailable."
msgstr "Installation dovi_tool échouée — fonctionnalité Dolby Vision indisponible."

#: core/preflight.py:464
msgid "dovi_tool skipped — Dolby Vision files will not be handled optimally."
msgstr "dovi_tool ignoré — les fichiers Dolby Vision ne seront pas traités de façon optimale."

#: core/preflight.py:470
msgid "Download and install mkvmerge (external tracks) into ./bin/?"
msgstr "Télécharger et installer mkvmerge (pistes externes) dans ./bin/ ?"

#: core/preflight.py:473
msgid "mkvmerge installation failed — adding external tracks unavailable."
msgstr "Installation mkvmerge échouée — ajout de pistes externes indisponible."

#: core/preflight.py:475
msgid "mkvmerge skipped — adding external audio/subtitle tracks will be unavailable."
msgstr "mkvmerge ignoré — l'ajout de pistes audio/sous-titres externes sera indisponible."

#: core/preflight.py:481
msgid "Download and install mpv (resync check) into ./bin/?"
msgstr "Télécharger et installer mpv (contrôle du recalage) dans ./bin/ ?"

#: core/preflight.py:484
msgid "mpv installation failed — the resync can only be set blind."
msgstr "Installation mpv échouée — le recalage restera réglable à l'aveugle."

#: core/preflight.py:486
msgid "mpv skipped — you will not be able to check a resync by eye."
msgstr "mpv ignoré — vous ne pourrez pas contrôler un recalage à l'œil."

