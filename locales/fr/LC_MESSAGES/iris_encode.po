msgstr[1] "{file} — {count} pistes audio contre {reference_count} : le fichier joint n'en gardera que {kept}."

#: core/joiner.py:197
#, python-brace-format
msgid "{file} — {count} subtitle track against {reference_count}: the joined file will keep only {kept}."
msgid_plural "{file} — {count} subtitle tracks against {reference_count}: the joined file will keep only {kept}."
msgstr[0] "{file} — {count} piste de sous-titres contre {reference_count} : le fichier joint n'en gardera que {kept}."
msgstr[1] "{file} — {count} pistes de sous-titres contre {reference_count} : le fichier joint n'en gardera que {kept}."

#: core/joiner.py:221
#, python-brace-format
msgid "Join: at least {minimum} parts ({count} given)."
msgid_plural "Join: at least {minimum} parts ({count} given)."
msgstr[0] "Jonction : {minimum} parties au minimum ({count} donnée)."
msgstr[1] "Jonction : {minimum} parties au minimum ({count} données)."

#: core/joiner.py:228
msgid "Join: the same part is present twice."
msgstr "Jonction : la même partie est présente deux fois."

#: core/joiner.py:231
#, python-brace-format
msgid "Output path identical to one of the parts ({file}). Join refused to avoid corrupting the source file."
msgstr "Chemin de sortie identique à une partie ({file}). Jonction refusée pour éviter la corruption du fichier source."

