#: tui/screens/ancrage.py:81
msgid "Anchor point"
msgstr "Point de repère"

#: tui/screens/ancrage.py:84
msgid "When do you hear it?"
msgstr "À quel instant l'entendez-vous ?"

#: tui/screens/ancrage.py:87
msgid "Other line"
msgstr "Autre réplique"

#: tui/screens/ancrage.py:100
#, python-brace-format
msgid "Listen to the movie at the given point. If this line cannot be found, {key} offers another one."
msgstr "Écoutez le film à l'endroit indiqué. Si cette réplique ne se retrouve pas, {key} en propose une autre."

#. examples of time formats, keep them as they are.
#: tui/screens/ancrage.py:104
#, python-brace-format
msgid "Accepted formats: {examples}"
msgstr "Formats acceptés : {examples}"

#: tui/screens/ancrage.py:112
#: tui/screens/sync.py:682
msgid "No readable line in this track."
msgstr "Aucune réplique lisible dans cette piste."

#: tui/screens/ancrage.py:119
#, python-brace-format
msgid "Line {number} of {total}   ·   written at {time}"
