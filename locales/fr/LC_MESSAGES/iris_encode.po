msgstr "Aperçu"

#: tui/screens/aide.py:304
msgid "What would be done, without doing anything."
msgstr "Ce qui serait fait, sans rien faire."

#: tui/screens/aide.py:305
#: tui/screens/run.py:349
msgid "Encoding"
msgstr "Encodage"

#: tui/screens/aide.py:306
