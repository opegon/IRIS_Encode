msgid "Tracks"
msgstr "Pistes"

#: tui/screens/aide.py:300
msgid "What each track of the file will become."
msgstr "Ce que deviendra chaque piste du fichier."

#: tui/screens/aide.py:301
#: tui/screens/sync.py:298
msgid "Sync"
msgstr "Recalage"

#: tui/screens/aide.py:302
msgid "Add a track from another file, and put it back in time."
msgstr "Greffer une piste venue d'ailleurs, et la remettre à l'heure."

