#. "O" is the key pressed on the donor file screen.
#: core/cles.py:52
msgid "subtitles to download (O from the donor file)"
msgstr "sous-titres à télécharger (O depuis le fichier donneur)"

#: core/cles.py:53
msgid "without a key, no search; without an account, no download"
msgstr "sans clé, pas de recherche ; sans compte, pas de téléchargement"

#: core/cles.py:54
#: core/cles.py:64
msgid "API key"
msgstr "Clé d'API"

#: core/cles.py:55
msgid "Username"
msgstr "Identifiant"

#: core/cles.py:56
msgid "Password"
msgstr "Mot de passe"

#. "I" then "Tab" are the keys that open the IMDB info.
#: core/cles.py:62
msgid "full IMDB info (I, then Tab)"
msgstr "fiche IMDB complète (I, puis Tab)"

#: core/cles.py:63
msgid "without a key, the IMDB info is limited to IMDB's suggestions"
msgstr "sans clé, la fiche IMDB se réduit aux suggestions d'IMDB"

#: core/cles.py:126
#, python-brace-format
msgid "OMDb unreachable: {error}"
msgstr "OMDb injoignable : {error}"

#: core/cles.py:128
msgid "Key refused by OMDb — check it, or activate it with the link received by email."
msgstr "Clé refusée par OMDb — vérifiez-la, ou activez-la par le lien reçu par courriel."

#: core/cles.py:131
#, python-brace-format
msgid "OMDb answered {status}."
msgstr "OMDb a répondu {status}."

#. {error} is OMDb's own message, in English (L-08).
#: core/cles.py:135
#, python-brace-format
msgid "OMDb: “{error}”"
msgstr "OMDb : {error}"

#: core/cles.py:136
msgid "negative answer"
msgstr "réponse négative"

#: core/cles.py:138
msgid "OMDb returned an unreadable answer."
msgstr "OMDb a rendu une réponse illisible."

#: core/cles.py:149
msgid "Give both the username and the password, or neither."
msgstr "Donnez l'identifiant et le mot de passe, ou aucun des deux."

#: core/cles.py:161
#, python-brace-format
msgid "OpenSubtitles unreachable: {error}"
msgstr "OpenSubtitles injoignable : {error}"

#: core/cles.py:163
msgid "API key refused by OpenSubtitles."
msgstr "Clé d'API refusée par OpenSubtitles."

#: core/cles.py:165
msgid "OpenSubtitles allows one login per second — try again."
msgstr "OpenSubtitles limite les connexions à une par seconde — réessayez."

#: core/cles.py:167
msgid "Username or password refused by OpenSubtitles."
msgstr "Identifiant ou mot de passe refusé par OpenSubtitles."

#: core/cles.py:170
#, python-brace-format
msgid "OpenSubtitles answered {status}."
msgstr "OpenSubtitles a répondu {status}."

#. separator between the first items of a list ("a, b and c").
#: core/i18n.py:93
msgctxt "list"
msgid ", "
msgstr ", "

#. joins the last item of a list; {items} is "a, b".
#: core/i18n.py:95
#, python-brace-format
msgctxt "list"
msgid "{items} and {last}"
msgstr "{items} et {last}"

#: tui/screens/cles.py:99
#, python-brace-format
msgid "{usage} — {without_key}."
msgstr "{usage} — {without_key}."
