#. "O" is the key pressed on the donor file screen.
#: core/cles.py:52
msgid "subtitles to download (O from the donor file)"
msgstr "sous-titres à télécharger (O depuis le fichier donneur)"

#: core/cles.py:53
msgid "without a key, no search; without an account, no download"
msgstr "sans clé, pas de recherche ; sans compte, pas de téléchargement"

#: core/cles.py:54
#: core/cles.py:64
msgid "API key"
msgstr "Clé d'API"

#: core/cles.py:55
msgid "Username"
msgstr "Identifiant"

#: core/cles.py:56
#: tui/screens/emplacements.py:212
msgid "Password"
msgstr "Mot de passe"

#. "I" then "Tab" are the keys that open the IMDB info.
#: core/cles.py:62
msgid "full IMDB info (I, then Tab)"
msgstr "fiche IMDB complète (I, puis Tab)"

#: core/cles.py:63
msgid "without a key, the IMDB info is limited to IMDB's suggestions"
msgstr "sans clé, la fiche IMDB se réduit aux suggestions d'IMDB"

#: core/cles.py:126
#, python-brace-format
msgid "OMDb unreachable: {error}"
msgstr "OMDb injoignable : {error}"

#: core/cles.py:128
msgid "Key refused by OMDb — check it, or activate it with the link received by email."
msgstr "Clé refusée par OMDb — vérifiez-la, ou activez-la par le lien reçu par courriel."

#: core/cles.py:131
#, python-brace-format
msgid "OMDb answered {status}."
msgstr "OMDb a répondu {status}."

#. {error} is OMDb's own message, in English (L-08).
#. {error} is OMDb's own message, in English.
#: core/cles.py:135
#: core/meta.py:155
#, python-brace-format
msgid "OMDb: “{error}”"
msgstr "OMDb : {error}"

#: core/cles.py:136
msgid "negative answer"
msgstr "réponse négative"

#: core/cles.py:138
msgid "OMDb returned an unreadable answer."
msgstr "OMDb a rendu une réponse illisible."

#: core/cles.py:149
msgid "Give both the username and the password, or neither."
msgstr "Donnez l'identifiant et le mot de passe, ou aucun des deux."

#: core/cles.py:161
#: core/opensubtitles.py:154
#, python-brace-format
msgid "OpenSubtitles unreachable: {error}"
msgstr "OpenSubtitles injoignable : {error}"

#: core/cles.py:163
msgid "API key refused by OpenSubtitles."
msgstr "Clé d'API refusée par OpenSubtitles."

#: core/cles.py:165
msgid "OpenSubtitles allows one login per second — try again."
msgstr "OpenSubtitles limite les connexions à une par seconde — réessayez."

#: core/cles.py:167
msgid "Username or password refused by OpenSubtitles."
msgstr "Identifiant ou mot de passe refusé par OpenSubtitles."

#: core/cles.py:170
#, python-brace-format
msgid "OpenSubtitles answered {status}."
msgstr "OpenSubtitles a répondu {status}."

#: core/decision.py:86
msgid "manually excluded"
msgstr "exclu manuellement"

#. a track copied unchanged into the output ("→ copy").
#: core/decision.py:93
#: core/decision.py:163
msgctxt "track action"
msgid "copy"
msgstr "copie"

#. an image subtitle converted to SRT text by character recognition. "SRT" and "OCR" stay as they are.
#: core/decision.py:101
msgid "SRT (OCR)"
msgstr "SRT (OCR)"

#: core/decision.py:999
msgid "HDR source"
msgstr "source HDR"

#: core/decision.py:1002
msgid "needs ffmpeg with libplacebo"
msgstr "demande ffmpeg avec libplacebo"

#: core/decision.py:1050
#, python-brace-format
msgid "{reason} · no upscaling: {why}"
msgstr "{reason} · pas d'agrandissement : {why}"

#: core/decision.py:1060
#, python-brace-format
msgid "Upscale {width}x{height} → {target_width}x{target_height} (super-resolution ×{factor:.2f}, two passes)"
msgstr "Agrandi {width}x{height} → {target_width}x{target_height} (super-résolution ×{factor:.2f}, deux passes)"

#: core/decision.py:1063
#, python-brace-format
msgid "Upscale {width}x{height} → {target_width}x{target_height} (super-resolution ×{factor:.2f})"
msgstr "Agrandi {width}x{height} → {target_width}x{target_height} (super-résolution ×{factor:.2f})"

#: core/decision.py:1096
#, python-brace-format
msgid "{dv} → {target}: needs the Dolby Vision tool (ffmpeg with libplacebo, in ./bin/dv/)"
msgstr "{dv} → {target} : demande l'outil Dolby Vision (ffmpeg avec libplacebo, dans ./bin/dv/)"

#: core/decision.py:1141
#, python-brace-format
msgid "{reason} · DV preserved, RPU reinjected"
msgstr "{reason} · DV préservé, RPU réinjecté"

#: core/decision.py:1143
#, python-brace-format
msgid "{reason} · DV kept → video copied"
msgstr "{reason} · DV conservé → vidéo copiée"

#: core/decision.py:1152
#, python-brace-format
msgid "Unknown bitrate → {target}k target"
msgstr "Débit inconnu → cible {target}k"

#: core/decision.py:1165
#, python-brace-format
msgid "Bitrate {bitrate}k > {target}k target +{tolerance}%"
msgstr "Débit {bitrate}k > {target}k cible +{tolerance}%"

#: core/decision.py:1179
#, python-brace-format
msgid "Resolution {width}x{height} > {max_width}x{max_height}"
msgstr "Résolution {width}x{height} > {max_width}x{max_height}"

#: core/decision.py:1193
#, python-brace-format
msgid "Codec {codec} not supported by the playback chain"
msgstr "Codec {codec} non lu par la chaîne"

#: core/decision.py:1209
#, python-brace-format
msgid "{dv} → HDR10 without re-encoding"
msgstr "{dv} → HDR10 sans réencodage"

#: core/decision.py:1220
#, python-brace-format
msgid "Bitrate within target ±{tolerance}%, resolution OK, codec {codec}"
msgstr "Débit dans la cible ±{tolerance}%, résolution OK, codec {codec}"

#: core/decision.py:1223
#, python-brace-format
msgid "Bitrate OK, resolution OK, codec {codec}"
msgstr "Débit OK, résolution OK, codec {codec}"

#: core/decision.py:1403
msgid "unknown codec, no decoder (encrypted?) → excluded"
msgstr "codec inconnu, sans décodeur (chiffré ?) → écartée"

#: core/decision.py:1406
msgid "manual selection"
msgstr "sélection manuelle"

#: core/decision.py:1409
#, python-brace-format
msgid "replaced by its {codec} core (track {index})"
msgstr "remplacée par son cœur {codec} (piste {index})"

#: core/decision.py:1413
#, python-brace-format
msgid "core of track {index}, which already carries it"
msgstr "cœur de la piste {index}, qui le porte déjà"

#: core/decision.py:1417
#, python-brace-format
msgid "original track (index {index})"
msgstr "piste originale (index {index})"

#: core/decision.py:1422
msgid "language unknown → kept"
msgstr "langue inconnue → gardée"

#: core/decision.py:1425
#, python-brace-format
msgid "language {language}"
msgstr "langue {language}"

#: core/decision.py:1428
#, python-brace-format
msgid "language {language} not kept"
msgstr "langue {language} non retenue"

#. "lossless", "copy" and the profile key preserve_hd_audio stay in English (glossary).
#: core/decision.py:1463
#, python-brace-format
msgid "{reason} · lossless + preserve_hd_audio → copy"
msgstr "{reason} · lossless + preserve_hd_audio → copy"

#: core/decision.py:1470
#, python-brace-format
msgid "{reason} · lossless → {codec}"
msgstr "{reason} · lossless → {codec}"

#: core/decision.py:1479
#, python-brace-format
msgid "{reason} · {codec} compatible → copy"
msgstr "{reason} · {codec} compatible → copy"

#: core/decision.py:1487
#, python-brace-format
msgid "{reason} · → {codec}"
msgstr "{reason} · → {codec}"

#: core/decision.py:1509
#, python-brace-format
msgid "Cannot read the audio track of “{file}” added to this file: the profile's audio rule cannot be applied to it."
msgstr "Impossible de lire la piste audio de « {file} » greffée sur ce fichier : la règle audio du profil ne peut pas s'y appliquer."

#: core/decision.py:1514
msgid "added track"
msgstr "piste greffée"

#: core/decision.py:1780
msgid "H264 does not carry HDR: this file will be converted to SDR (tone mapping, slower). Choose HEVC to keep HDR."
msgstr "H264 ne porte pas le HDR : ce fichier sera converti en SDR (tone mapping, plus lent). Choisissez HEVC pour garder le HDR."

#: core/decision.py:1815
msgid "Forced manually (was SKIP)"
msgstr "Forcé manuellement (était SKIP)"

#: core/decision.py:1817
msgid "Forced manually (was DV removal)"
msgstr "Forcé manuellement (était retrait DV)"

#: core/decision.py:1946
#, python-brace-format
msgid "{reason} · {tracks} for the playback chain → remux"
msgstr "{reason} · {tracks} pour la chaîne de lecture → remux"

#: core/emplacements.py:127
msgid "The label is required."
msgstr "Le libellé est obligatoire."

#: core/emplacements.py:129
msgid "Another location already has this label."
msgstr "Un autre emplacement porte déjà ce libellé."

#: core/emplacements.py:131
#: tui/screens/emplacements.py:301
msgid "The path is required."
msgstr "Le chemin est obligatoire."

#: core/emplacements.py:135
msgid "A network path reads \\\\server\\share."
msgstr "Un chemin réseau s'écrit \\\\serveur\\partage."

#: core/emplacements.py:138
#, python-brace-format
msgid "This path is already the location “{label}”."
msgstr "Ce chemin est déjà l'emplacement « {label} »."

#: core/emplacements.py:162
msgid "access denied: this account has no right on the share"
msgstr "accès refusé : ce compte n'a aucun droit sur le partage"

#: core/emplacements.py:163
#: core/emplacements.py:166
msgid "server unreachable"
msgstr "serveur injoignable"

#: core/emplacements.py:164
msgid "this share does not exist on the server"
msgstr "ce partage n'existe pas sur le serveur"

#: core/emplacements.py:165
msgid "password refused"
msgstr "mot de passe refusé"

#: core/emplacements.py:167
msgid "no network"
msgstr "pas de réseau"

#: core/emplacements.py:168
msgid "Windows is already connected to this server under another account (a network drive, or another location). Windows allows one account per server"
msgstr "Windows est déjà connecté à ce serveur sous un autre compte (un lecteur réseau, ou un autre emplacement). Windows n'admet qu'un compte par serveur"

#: core/emplacements.py:171
msgid "account or password refused. Is an identity saved for this server in the Windows Credential Manager?"
msgstr "compte ou mot de passe refusé. Une identité est-elle enregistrée pour ce serveur dans le Gestionnaire d'identifiants Windows ?"

#: core/emplacements.py:173
msgid "account restriction"
msgstr "restriction du compte"

#: core/emplacements.py:174
msgid "password expired"
msgstr "mot de passe expiré"

#: core/emplacements.py:175
msgid "account disabled"
msgstr "compte désactivé"

#: core/emplacements.py:176
msgid "account locked"
msgstr "compte verrouillé"

#: core/emplacements.py:177
msgid "invalid user name"
msgstr "nom d'utilisateur invalide"

#: core/emplacements.py:198
#, python-brace-format
msgid "Windows error {code}"
msgstr "erreur Windows {code}"

#: core/emplacements.py:304
msgid "Folder reachable."
msgstr "Dossier accessible."

#: core/emplacements.py:305
msgid "Folder unreachable: is it mounted?"
msgstr "Dossier inaccessible : est-il monté ?"

#: core/emplacements.py:315
#, python-brace-format
msgid "Connection refused: {cause}"
msgstr "Connexion refusée : {cause}"

#: core/emplacements.py:325
#, python-brace-format
msgid "Connected, but the share cannot be read: {cause}"
msgstr "Connecté, mais le partage ne se lit pas : {cause}"

#: core/emplacements.py:328
msgid "Windows is already connected to this share: it is readable, with the account of that connection. Another account cannot be tested while it is open."
msgstr "Windows est déjà connecté à ce partage : il se lit, avec le compte de cette connexion. Un autre compte ne peut pas s'essayer tant qu'elle est ouverte."

#: core/emplacements.py:331
msgid "Connection successful: the share is readable."
msgstr "Connexion réussie : le partage se lit."

#: core/emplacements.py:355
#, python-brace-format
msgid "{location}: {cause}"
msgstr "{location} : {cause}"

#: core/emplacements.py:451
msgid "Saving an identity needs Windows."
msgstr "Enregistrer une identité demande Windows."

#: core/emplacements.py:463
#, python-brace-format
msgid "Windows refused to save the identity (error {code})."
msgstr "Windows a refusé d'enregistrer l'identité (erreur {code})."

#: core/emplacements.py:476
#, python-brace-format
msgid "Windows refused to remove the identity (error {code})."
msgstr "Windows a refusé de retirer l'identité (erreur {code})."

#: core/encoder.py:370
msgid "This graphics card cannot encode this format. AV1 with NVENC needs an RTX 40 or newer; HEVC and H264 remain available."
msgstr "Cette carte graphique ne sait pas encoder ce format. L'AV1 par NVENC demande une RTX 40 ou plus récente ; le HEVC et le H264 restent disponibles."

#: core/encoder.py:373
msgid "NVENC refused: this ffmpeg needs a newer NVIDIA driver than the one installed. Update the driver, or use an ffmpeg built for an older NVENC API."
msgstr "NVENC refusé : ce ffmpeg exige un pilote NVIDIA plus récent que celui installé. Mettre à jour le pilote, ou prendre un ffmpeg compilé pour une API NVENC plus ancienne."

#: core/encoder.py:377
msgid "The encoder could not be opened on this computer. If it is AV1: NVENC only encodes it from the RTX 40 series."
msgstr "L'encodeur n'a pas pu s'ouvrir sur cette machine. Si c'est de l'AV1 : NVENC ne l'encode qu'à partir des RTX 40."

#: core/encoder.py:380
msgid "The NVIDIA driver cannot be found. Without it, no accelerated encoding is possible."
msgstr "Le pilote NVIDIA est introuvable. Sans lui, aucun encodage accéléré n'est possible."

#: core/encoder.py:383
msgid "The requested bitrate is outside what the encoder accepts. Choose a value within the range it announces."
msgstr "Le débit demandé sort de ce que l'encodeur accepte. Choisissez une valeur dans la plage qu'il annonce."

#: core/encoder.py:386
msgid "The chosen encoder does not support this channel layout or this pixel format."
msgstr "L'encodeur choisi ne prend pas cette disposition de canaux ou ce format de pixels."

#: core/encoder.py:389
msgid "The destination disk is full."
msgstr "Le disque de destination est plein."

#: core/encoder.py:391
msgid "Writing to this location is not allowed."
msgstr "Écriture refusée à cet emplacement."

#: core/encoder.py:607
msgid "the output file was not written"
msgstr "le fichier de sortie n'a pas été écrit"

#: core/encoder.py:609
msgid "the output file is empty"
msgstr "le fichier de sortie est vide"

#: core/encoder.py:619
msgid "the output lasts {got:.0f} s, {expected:.0f} s expected: it is incomplete"
msgstr "la sortie dure {got:.0f} s au lieu de {expected:.0f} s : elle est incomplète"

#: core/encoder.py:1047
#, python-brace-format
msgid "Output path identical to the source ({path}). Empty suffix and same container — encoding refused to avoid corrupting the source file."
msgstr "Chemin de sortie identique à la source ({path}). Suffixe vide et conteneur identique — encodage refusé pour éviter la corruption du fichier source."

#: core/encoder.py:1067
#, python-brace-format
msgid "{dv} → HDR10/SDR needs the Dolby Vision tool (ffmpeg with libplacebo, in ./bin/dv/): without it, the colors come out wrong."
msgstr "{dv} → HDR10/SDR demande l'outil Dolby Vision (ffmpeg avec libplacebo, dans ./bin/dv/) : sans lui, les couleurs sortent fausses."

#. -itsoffset is an ffmpeg option, keep it as is.
#: core/encoder.py:1138
#, python-brace-format
msgid "The track “{track}” needs a stretch factor, which ffmpeg cannot apply in one pass (-itsoffset only shifts by a constant offset). mkvmerge can: install it so that the track is added through it."
msgstr "La piste « {track} » demande un facteur d'étirement, que ffmpeg ne sait pas appliquer en une passe (-itsoffset ne fait qu'un décalage constant). mkvmerge sait le faire : installez-le pour que la greffe passe par lui."

#. the name of YOUR language, written in your language ("Français", "Deutsch") — not the word "English" translated. Shown in the language choice of the Options screen.
#: core/i18n.py:84
msgctxt "language name"
msgid "English"
msgstr "Français"

#. separator between the first items of a list ("a, b and c").
#: core/i18n.py:162
msgctxt "list"
msgid ", "
msgstr ", "

#. joins the last item of a list; {items} is "a, b".
#: core/i18n.py:164
#, python-brace-format
msgctxt "list"
msgid "{items} and {last}"
msgstr "{items} et {last}"

#: core/joiner.py:128
#, python-brace-format
msgid "At least {minimum} parts are needed to join ({count} selected)."
msgid_plural "At least {minimum} parts are needed to join ({count} selected)."
msgstr[0] "Il faut au moins {minimum} parties à joindre ({count} sélectionnée)."
msgstr[1] "Il faut au moins {minimum} parties à joindre ({count} sélectionnées)."

#: core/joiner.py:140
#, python-brace-format
msgid "{file} — video in {codec}, {reference} in {reference_codec}."
msgstr "{file} — vidéo en {codec}, {reference} en {reference_codec}."

#: core/joiner.py:145
#, python-brace-format
msgid "{file} — {width}x{height}, {reference} in {reference_width}x{reference_height}."
msgstr "{file} — {width}x{height}, {reference} en {reference_width}x{reference_height}."

#: core/joiner.py:156
#, python-brace-format
msgid "{file} — audio track {number} in {codec}, {reference_codec} in {reference}."
msgstr "{file} — piste audio {number} en {codec}, {reference_codec} dans {reference}."

#: core/joiner.py:162
#, python-brace-format
msgid "{file} — audio track {number} in {layout}, {reference_layout} in {reference}."
msgstr "{file} — piste audio {number} en {layout}, {reference_layout} dans {reference}."

#: core/joiner.py:170
#, python-brace-format
msgid "{file} — audio track {number} at {rate} Hz, {reference_rate} Hz in {reference}."
msgstr "{file} — piste audio {number} à {rate} Hz, {reference_rate} Hz dans {reference}."

#: core/joiner.py:180
#, python-brace-format
msgid "{file} — audio track {number} in {language}, {reference_language} in {reference}: the joined track would change language midway."
msgstr "{file} — piste audio {number} en {language}, {reference_language} dans {reference} : la piste recollée changerait de langue en cours de route."

#: core/joiner.py:188
#, python-brace-format
msgid "{file} — {count} audio track against {reference_count}: the joined file will keep only {kept}."
msgid_plural "{file} — {count} audio tracks against {reference_count}: the joined file will keep only {kept}."
msgstr[0] "{file} — {count} piste audio contre {reference_count} : le fichier joint n'en gardera que {kept}."
msgstr[1] "{file} — {count} pistes audio contre {reference_count} : le fichier joint n'en gardera que {kept}."

#: core/joiner.py:197
#, python-brace-format
msgid "{file} — {count} subtitle track against {reference_count}: the joined file will keep only {kept}."
msgid_plural "{file} — {count} subtitle tracks against {reference_count}: the joined file will keep only {kept}."
msgstr[0] "{file} — {count} piste de sous-titres contre {reference_count} : le fichier joint n'en gardera que {kept}."
msgstr[1] "{file} — {count} pistes de sous-titres contre {reference_count} : le fichier joint n'en gardera que {kept}."

#: core/joiner.py:221
#, python-brace-format
msgid "Join: at least {minimum} parts ({count} given)."
msgid_plural "Join: at least {minimum} parts ({count} given)."
msgstr[0] "Jonction : {minimum} parties au minimum ({count} donnée)."
msgstr[1] "Jonction : {minimum} parties au minimum ({count} données)."

#: core/joiner.py:228
msgid "Join: the same part is present twice."
msgstr "Jonction : la même partie est présente deux fois."

#: core/joiner.py:231
#, python-brace-format
msgid "Output path identical to one of the parts ({file}). Join refused to avoid corrupting the source file."
msgstr "Chemin de sortie identique à une partie ({file}). Jonction refusée pour éviter la corruption du fichier source."

#: core/meta.py:156
msgid "result not found"
msgstr "résultat introuvable"

#: core/meta.py:203
msgid "Unexpected IMDB answer"
msgstr "Réponse IMDB inattendue"

#: core/meta.py:216
#, python-brace-format
msgid "No IMDB result for “{title}”"
msgstr "Aucun résultat IMDB pour « {title} »"

#: core/meta.py:232
msgid "Rating and synopsis available with an OMDb key (omdbapi.com — free)."
msgstr "Note et synopsis disponibles avec une clé OMDb (omdbapi.com — gratuit)."

#: core/meta.py:313
#, python-brace-format
msgid "No AlloCiné result for “{title}”"
msgstr "Aucun résultat AlloCiné pour « {title} »"

#: core/meta.py:329
msgid "Cannot read the AlloCiné data (no JSON-LD)"
msgstr "Impossible de lire les données AlloCiné (JSON-LD absent)"

#. a track: codec, language code, then the track's name.
#: core/muxer.py:98
#, python-brace-format
msgid "{codec} {language} “{name}”"
msgstr "{codec} {language} « {name} »"

#: core/muxer.py:291
#, python-brace-format
msgid "Track {track} of “{file}” cannot be found by mkvmerge (missing, unreadable or changed file): it will not be guessed."
msgstr "mkvmerge ne retrouve pas la piste {track} de « {file} » (fichier absent, illisible ou modifié) : elle ne sera pas devinée."

#: core/muxer.py:398
msgid "No external track to add."
msgstr "Aucune piste externe à greffer."

#: core/muxer.py:401
#, python-brace-format
msgid "Output path identical to the source ({path}). Mux refused to avoid corrupting the source file."
msgstr "Chemin de sortie identique à la source ({path}). Mux refusé pour éviter la corruption du fichier source."

#. "und" is the code players show for an unknown language; keep it as is.
#: core/muxer.py:410
#, python-brace-format
msgid "Missing language for track {track} of {file}. Without a language, the track shows as “und” in every player."
msgstr "Langue manquante pour la piste {track} de {file}. Sans langue, la piste apparaît en « und » dans tous les lecteurs."

#: core/muxer.py:501
#, python-brace-format
msgid "Output path identical to the source ({path}). Remux refused to avoid corrupting the source file."
msgstr "Chemin de sortie identique à la source ({path}). Remux refusé pour éviter la corruption du fichier source."

#. Ctrl+O is a key; "API keys" is the name of the section of the options.
#: core/opensubtitles.py:129
msgid "API key missing — enter it from the options (Ctrl+O, “API keys”)."
msgstr "Clé d'API absente — saisissez-la depuis les options (Ctrl+O, « Clés d'API »)."

#: core/opensubtitles.py:157
msgid "Refused by OpenSubtitles (401) — wrong API key, username or password."
msgstr "Refusé par OpenSubtitles (401) — clé d'API, identifiant ou mot de passe incorrect."

#. Ctrl+O is a key; "API keys" is the name of the section of the options.
#: core/opensubtitles.py:163
msgid "API key refused by OpenSubtitles (403) — check it from the options (Ctrl+O, “API keys”)."
msgstr "Clé d'API refusée par OpenSubtitles (403) — vérifiez-la depuis les options (Ctrl+O, « Clés d'API »)."

#: core/opensubtitles.py:171
#, python-brace-format
msgid "Too many requests — try again in {count} second."
msgid_plural "Too many requests — try again in {count} seconds."
msgstr[0] "Trop de requêtes — réessayez dans {count} seconde."
msgstr[1] "Trop de requêtes — réessayez dans {count} secondes."

#: core/opensubtitles.py:175
msgid "Too many requests — try again in a few seconds."
msgstr "Trop de requêtes — réessayez dans quelques secondes."

#: core/opensubtitles.py:178
#, python-brace-format
msgid "OpenSubtitles answered {status}: {detail}"
msgstr "OpenSubtitles a répondu {status} : {detail}"

#: core/opensubtitles.py:185
#, python-brace-format
msgid "Unexpected answer from OpenSubtitles (not JSON): {detail}"
msgstr "Réponse inattendue d'OpenSubtitles (pas du JSON) : {detail}"

#. Ctrl+O is a key; "API keys" is the name of the section of the options.
#: core/opensubtitles.py:195
msgid "Downloading needs an account — enter a username and password from the options (Ctrl+O, “API keys”)."
msgstr "Télécharger demande un compte — saisissez identifiant et mot de passe depuis les options (Ctrl+O, « Clés d'API »)."

#: core/opensubtitles.py:202
msgid "Login refused: no token received."
msgstr "Connexion refusée : aucun jeton reçu."

#: core/opensubtitles.py:267
