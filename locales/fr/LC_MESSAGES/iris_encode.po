msgstr "{file} illisible ({error}) : cette session tourne sur les valeurs par défaut et ne le réécrira pas. Corrigez-le à la main, puis relancez."

#: tui/app.py:287
#, python-brace-format
msgid "{file}: invalid value ignored, the default applies — {keys}. Fix it by hand: the next save will write the default."
msgid_plural "{file}: invalid values ignored, the defaults apply — {keys}. Fix them by hand: the next save will write the defaults."
msgstr[0] "{file} : valeur invalide ignorée, la valeur par défaut s'applique — {keys}. Corrigez-la à la main : le prochain enregistrement écrira la valeur par défaut."
msgstr[1] "{file} : valeurs invalides ignorées, les valeurs par défaut s'appliquent — {keys}. Corrigez-les à la main : le prochain enregistrement écrira les valeurs par défaut."

#: tui/app.py:296
#, python-brace-format
msgid "profiles.toml could not be created ({error}): this session runs on the built-in profiles, and changes to them will not be kept."
msgstr "profiles.toml n'a pas pu être créé ({error}) : cette session tourne sur les profils livrés, et leurs modifications ne seront pas conservées."

#: tui/app.py:302
#, python-brace-format
msgid "Log file unavailable ({error}): nothing will be logged this session."
msgstr "Journal indisponible ({error}) : rien ne sera journalisé pendant cette session."

#: tui/app.py:352
#, python-brace-format
msgid "The folder of {count} source is read-only (mounted disc image?): its output cannot be written next to it."
msgid_plural "The folders of {count} sources are read-only (mounted disc image?): their outputs cannot be written next to them."
msgstr[0] "Le dossier de {count} source est en lecture seule (image disque montée ?) : sa sortie ne peut pas s'écrire à côté d'elle."
msgstr[1] "Les dossiers de {count} sources sont en lecture seule (image disque montée ?) : leurs sorties ne peuvent pas s'écrire à côté d'elles."

#: tui/app.py:379
#, python-brace-format
msgid "Already in the queue: {files}"
msgstr "Déjà dans la file : {files}"

#: tui/app.py:385
#, python-brace-format
msgid "{count} file added to the queue — {key} to follow it."
msgid_plural "{count} files added to the queue — {key} to follow it."
msgstr[0] "{count} fichier ajouté à la file — {key} pour la suivre."
msgstr[1] "{count} fichiers ajoutés à la file — {key} pour la suivre."

